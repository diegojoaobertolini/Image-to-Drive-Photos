{
  "manifest_version": 3,
  "name": "Image to Drive & Photos",
  "version": "1.1",
  "description": "Salva imagens diretamente no Google Drive e Google Fotos através do menu de contexto.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "identity",
    "notifications",
    "activeTab",
    "scripting",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "oauth2": {
    "client_id": "SEU_CLIENT_ID_AQUI.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/photoslibrary.appendonly"
    ]
  }
}
